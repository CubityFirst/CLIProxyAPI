# /etc/cliproxy-self-update.env (root-owned, mode 644)
# GitHub owner/repo whose releases may be installed. Requests can only name a tag;
# they cannot change this.
REPO=router-for-me/CLIProxyAPI
# Directory shared with the server (remote-management.server-update-dir).
UPDATE_DIR=/home/cliproxy/cliproxy/update
# Optional overrides:
# SERVICE=cliproxyapi
# BIN=/usr/local/bin/cli-proxy-api
# SERVICE_USER=cliproxy
# HEALTH_URL=http://127.0.0.1:8317/
# Release asset to install: _linux_amd64_no-plugin.tar.gz (static, no plugins),
# _linux_amd64.tar.gz (plugin support), or the _linux_aarch64 equivalents.
# ASSET_SUFFIX=_linux_amd64_no-plugin.tar.gz
